<Window x:Class="NDIMachine.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="NDI Machine" Width="1440" Height="1000" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <DockPanel Background="{StaticResource Canvas}" TextElement.Foreground="{StaticResource Ink}">
    <Border DockPanel.Dock="Top" Background="#151D26" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border Background="{StaticResource Accent}" CornerRadius="8" Width="42" Height="42" Margin="0,0,14,0"><TextBlock Text="N" Foreground="#10221E" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel><TextBlock Text="NDI Machine" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="FOUR-CHANNEL BROADCAST ROUTER" Style="{StaticResource Label}" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="{Binding ConnectionColor}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
          <Button Content="Start control host" Click="StartControl" Visibility="{Binding Offline, Converter={StaticResource VisibleIf}}" Margin="0,0,10,0" />
          <Button Content="Diagnostics" Click="ShowDiagnostics" />
          <Button Content="Engine controls" Click="EngineControls" Margin="8,0,0,0" />
          <Button Content="Discovery / IPs" Click="DiscoverySettings" IsEnabled="{Binding CanDiscover}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#151D26" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,20,0" MaxHeight="48" /><TextBlock Grid.Column="1" Text="HARDWARE MODE  /  v0.6.1" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /></Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="Production" Tag="production" GroupName="WorkMode" IsChecked="{Binding ProductionMode, Mode=OneWay}" Click="SelectMode" Foreground="{StaticResource Ink}" FontSize="17" Margin="0,0,24,0" />
            <RadioButton Content="Failover" Tag="failover" GroupName="WorkMode" IsChecked="{Binding FailoverMode, Mode=OneWay}" Click="SelectMode" Foreground="{StaticResource Ink}" FontSize="17" />
          </StackPanel>
          <TextBlock Text="{Binding ModeDescription}" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
          <TextBlock Text="{Binding ReceiverSummary}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding ModeHeading}" FontSize="26" FontWeight="SemiBold" /><CheckBox Content="Local previews · no extra NDI subscriptions" IsChecked="{Binding PreviewsEnabled}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Refresh sources" Click="DiscoverSources" IsEnabled="{Binding CanDiscover}" ToolTip="{Binding SourceNotice}" /><Button Content="Prepare backups" Visibility="{Binding FailoverMode, Converter={StaticResource VisibleIf}}" Style="{StaticResource Primary}" Click="PrepareBackups" IsEnabled="{Binding CanPrepare}" Margin="8,0,0,0" ToolTip="Start or restore all commissioned backup sources. Does not change Videohub routes." /></StackPanel>
          </Grid>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="{Binding ReadyCaption}" Style="{StaticResource Label}" /><TextBlock Text="{Binding Readiness}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,3,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="{Binding AudioCaption}" Style="{StaticResource Label}" /><TextBlock Text="{Binding AudioSummary}" FontSize="22" Margin="0,7,0,0" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="WORKER RECOVERY" Style="{StaticResource Label}" /><TextBlock Text="{Binding Armed}" FontSize="22" Margin="0,7,0,0" /></StackPanel></Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Outputs}" Margin="-6,0,-6,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Margin="6,0,6,12" Padding="12">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="25" FontWeight="Light" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Connector}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </Grid>
                  <Border Background="#111922" CornerRadius="6" Padding="12,8" Margin="0,6,0,6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <StackPanel><Border Background="#090D12" Width="128" Height="72"><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" /></Border><TextBlock Text="{Binding PreviewCaption}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="COMMITTED SOURCE" Style="{StaticResource Label}" /><TextBlock Text="{Binding Source}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,5" ToolTip="{Binding Source}" /><TextBlock Text="{Binding Format}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel>
                    </Grid>
                  </Border>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="SDI FRAMES COMPLETED" Style="{StaticResource Label}" /><TextBlock Text="{Binding Completed}" FontFamily="Consolas" FontSize="22" Margin="0,3,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding AudioStatus}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Deadlines}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,6,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding LiveRouting}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,4,0,0" /><TextBlock Text="{Binding Timing}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,4" />
                  <Button Content="Edit output · video / audio / hardware" Click="EditOutput" IsEnabled="{Binding CanRoute}" Margin="0,4,0,0" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0} settings'}"/>
                  <StackPanel Margin="0,10,0,0" Visibility="{Binding DataContext.ProductionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                    <DockPanel><TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Destinations}" DisplayMemberPath="Label" SelectedValuePath="Input" SelectedValue="{Binding RouteTarget}" AutomationProperties.Name="{Binding Name, StringFormat='ATEM destination for {0}'}"/></DockPanel>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Button Content="Route to ATEM" Click="RouteOutputToAtem" IsEnabled="{Binding CanSendToAtem}" Style="{StaticResource Primary}" Padding="8,8" ToolTip="Route this running source to the selected ATEM input through Videohub."/>
                      <Button Grid.Column="2" Content="Return default" Click="ReturnOutputDefault" IsEnabled="{Binding CanReturnDefault}" Padding="8,8" ToolTip="{Binding ReturnDefaultLabel}"/>
                    </Grid>
                    <TextBlock Text="{Binding DefaultRouteLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                  </StackPanel>
                  <Button Content="Stop source" Click="StopOutput" IsEnabled="{Binding CanStop}" Margin="0,6,0,0" ToolTip="Release this NDI receiver and SDI output. Its destinations lose video until rerouted." />
                  <Expander Header="Receiver statistics &amp; audio meters" Foreground="{StaticResource Muted}" Margin="0,6,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding NdiStats}" FontFamily="Consolas" FontSize="11"/><Separator/><TextBlock Text="{Binding AudioStats}" FontFamily="Consolas" FontSize="11"/></StackPanel></Expander>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2" Visibility="{Binding ProductionMode, Converter={StaticResource VisibleIf}}">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="NDI → SDI" Style="{StaticResource Label}" /><TextBlock Text="Route your production" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,16" />
            <TextBlock Text="Choose an NDI source in Edit output. Check Also route Videohub, select an ATEM input, and Apply.&#10;&#10;For an already running source, select its destination below the preview and click Route to ATEM." Foreground="{StaticResource Muted}" />
            <Separator /><TextBlock Text="Discovery / IPs adds remote senders. Receiver settings, audio levels, delay and statistics are available per output." Foreground="{StaticResource Muted}" FontSize="12" />
            <Button Content="Return ALL to default" Click="ReturnSdi" IsEnabled="{Binding CanProductionRoute}" Style="{StaticResource Primary}" Margin="0,16,0,12" ToolTip="Restore all eight ATEM inputs to the saved default Videohub routes. Review the full map before applying." />
            <TextBlock Text="{Binding DefaultRoutesSummary}" FontSize="13" Foreground="{StaticResource Muted}"/>
            <Separator /><TextBlock Text="{Binding ProductionRouteStatus}" Foreground="{StaticResource Accent}" FontSize="12" />
            <TextBlock Text="Routing uses the existing Companion connection. Source-only output editing works independently. Return default keeps receivers running." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <TextBlock Text="The Stream Deck failover button can take over these outputs with the saved emergency preset. Hold 3 seconds and release to restore the previous production, video and audio settings." Foreground="{StaticResource Muted}" FontSize="12" Margin="6,18,6,0" />
          <TextBlock Text="Closing this window leaves your outputs running." Foreground="{StaticResource Muted}" FontSize="12" Margin="6,18,6,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Visibility="{Binding FailoverMode, Converter={StaticResource VisibleIf}}">
          <Border Style="{StaticResource Card}" BorderBrush="#4C625D" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="EMERGENCY CONTROL" Style="{StaticResource Label}" /><TextBlock Text="Fiber ↔ Network" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,10" />
              <TextBlock Text="{Binding CompanionStatus}" Foreground="{Binding CompanionColor}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="{Binding CompanionReason}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
              <Button Content="Open Companion  ↗" Click="OpenCompanion" Margin="0,16,0,16" />
              <TextBlock Text="Short press: overwrite routes.&#10;Hold 3 seconds + release: revert." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" />
              <TextBlock Text="NETWORK" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding NetworkAudioSummary}" FontSize="12" Margin="0,5,0,12" />
              <TextBlock Text="FIBER" Foreground="#F6BD75" FontSize="11" FontWeight="Bold" /><TextBlock Text="ZOOM MADI · XLR + MADI 1/2 + 3/4" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="COMMISSIONED VIDEOHUB MAP" Style="{StaticResource Label}" /><TextBlock Text="Physical ports · plan only" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14" />
              <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,13"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Mapping}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Live route confirmation is shown in Companion." Foreground="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FAILOVER AUDIO PRESET" Style="{StaticResource Label}" /><TextBlock Text="Dante USB I/O Module" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,5" /><TextBlock Text="{Binding PresetAudioSummary}" Foreground="{StaticResource Muted}" FontSize="12" /><Separator />
            <TextBlock Text="Physical signal: Unverified" Foreground="#F6BD75" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Counters confirm software scheduling. Verify picture, sound and sync at the ATEM." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
          </StackPanel></Border>
          <TextBlock Text="Closing this window leaves the media workers running." Foreground="{StaticResource Muted}" FontSize="12" Margin="6,18,6,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
